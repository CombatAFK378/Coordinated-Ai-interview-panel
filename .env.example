# ---- LiveKit voice transport ----
# Use the WebSocket URL and API key/secret from your LiveKit Cloud project.
# Docker hosts the agent; LiveKit Cloud carries the room audio/video.
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# bvc / nc require LiveKit Cloud. Use off for a self-hosted LiveKit server.
LIVEKIT_NOISE_CANCELLATION=bvc
# Deepgram streaming STT and a distinct Aura voice for every panel persona.
DEEPGRAM_API_KEY=
LIVEKIT_STT_MODEL=nova-3
LIVEKIT_STT_LANGUAGE=en-US
# v1-mini audio turn detection runs locally; no separate model download.
LIVEKIT_ENDPOINTING_MIN_DELAY=0.5
LIVEKIT_ENDPOINTING_MAX_DELAY=4.0
# Recruiter voice always supports interruptions; this controls interviews.
ALLOW_BARGEIN=true
# Set 8081 to run alongside an existing Agora container on port 8080.
APP_PORT=8080

# ---- LLM providers (both OpenAI-compatible) ----
# Required from Phase 2 on. Model ids carry a provider prefix: "groq:" or
# "openrouter:" (unprefixed = OpenRouter). The router walks the fallback chain
# across providers, so the fast path can be Groq with an OpenRouter fallback.
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Optional: pool of Groq keys from SEPARATE accounts, comma-separated. The router
# round-robins across them so the per-account tokens/min limit is shared out
# (same model + quality, ~Nx the free budget). Leave blank to use GROQ_API_KEY.
GROQ_API_KEYS=
# Fast model (candidate is waiting). gpt-oss-120b on Groq is sub-second.
LLM_FAST_MODEL=groq:openai/gpt-oss-120b
# Deep model for scoring/debate (used from Phase 5).
LLM_REASONING_MODEL=gemini:gemini-2.5-flash
LLM_REASONING_FALLBACKS=groq:openai/gpt-oss-120b,gemini:gemini-2.0-flash
# Comma-separated fallback ids, tried in order after the primary. Free model ids
# rotate without notice — keep a couple here so a delisting can't stall a turn.
LLM_FALLBACK_CHAIN=openrouter:inclusionai/ling-3.0-flash-fin:free

# Gemini reasoning and optional browser-based live coding round.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Existing saved interviews remain compatible.
DATA_DIR=/app/data
