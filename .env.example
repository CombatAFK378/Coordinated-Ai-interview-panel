# ---- LiveKit voice transport ----
# Use the WebSocket URL and API key/secret from your LiveKit Cloud project.
# Docker hosts the agent; LiveKit Cloud carries the room audio/video.
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# bvc / nc require LiveKit Cloud. Use off for a self-hosted LiveKit server.
LIVEKIT_NOISE_CANCELLATION=bvc
# Deepgram streaming STT and a distinct Aura voice for every panel persona.
DEEPGRAM_API_KEY=
LIVEKIT_STT_MODEL=nova-3
# Indian English — nova-3 also supports en-US, en-GB, en-AU, en-CA, en-NZ.
LIVEKIT_STT_LANGUAGE=en-IN
# Speech-to-text engine: deepgram (nova-3, above) or sarvam (Saaras, built for
# Indian accents and names; needs SARVAM_API_KEY). Voices are always Deepgram.
STT_PROVIDER=deepgram
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
# v1-mini audio turn detection runs locally; no separate model download.
LIVEKIT_ENDPOINTING_MIN_DELAY=0.5
LIVEKIT_ENDPOINTING_MAX_DELAY=4.0
# Ask the Panel by phone: the agent name the dispatch rule calls (see
# media-worker/phone_setup.py; empty disables), and the time zone callers mean
# when they say "the 4:30 interview".
PHONE_AGENT_NAME=panel-phone
LOCAL_TIMEZONE=Asia/Kolkata

# ---- Ask the Panel on WhatsApp (Twilio sandbox + ngrok tunnel) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# "whatsapp:" + the sandbox number shown in Twilio's console
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Comma-separated numbers allowed to chat (+91…); empty = anyone who joined the sandbox
WHATSAPP_ALLOWED_NUMBERS=
# From dashboard.ngrok.com: Your Authtoken, and your free domain (Domains)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
# Recruiter voice always supports interruptions; this controls interviews.
ALLOW_BARGEIN=true
# Host port for the app (default 8080).
APP_PORT=8080

# ---- LLM providers (all OpenAI-compatible) ----
# Model ids carry a provider prefix: "ollama:", "groq:", "gemini:" or
# "openrouter:" (unprefixed = OpenRouter). The router walks the fallback chain
# across providers, skipping any provider without a key.
# Primary for both the interviewers and the orchestrator (ollama.com API key).
OLLAMA_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Optional: pool of Groq keys from SEPARATE accounts, comma-separated. The router
# round-robins across them so the per-account tokens/min limit is shared out
# (same model + quality, ~Nx the free budget). Leave blank to use GROQ_API_KEY.
GROQ_API_KEYS=
# Fast model / interviewers (candidate is waiting), then its fallbacks in order.
LLM_FAST_MODEL=ollama:gpt-oss:120b
LLM_FALLBACK_CHAIN=groq:openai/gpt-oss-120b,gemini:gemini-2.5-flash
# Orchestrator / reasoning model (dossier, scoring, debate, conclusion), called
# with thinking off, then its fallbacks in order.
LLM_REASONING_MODEL=ollama:minimax-m3
LLM_REASONING_FALLBACKS=gemini:gemini-2.5-flash,groq:openai/gpt-oss-120b
# Ask the Panel answers (voice + WhatsApp), one call per question: Groq first for
# speed, then its fallbacks in order.
LLM_ASK_MODEL=groq:openai/gpt-oss-120b
LLM_ASK_FALLBACKS=ollama:gpt-oss:120b,gemini:gemini-2.5-flash

# Gemini reasoning fallback and optional browser-based live coding round.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Existing saved interviews remain compatible.
DATA_DIR=/app/data
